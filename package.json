{
  "name": "mcp-model-router",
  "version": "0.1.1",
  "description": "MCP-palvelin, joka valitsee mallin tehtävätyypin mukaan, näyttää LiteLLM/OpenRouter-kulutuksen ja vertailee malleja eval-ajoilla. Täydentää LiteLLM:ää, ei korvaa sitä.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "mcp-model-router": "dist/index.js"
  },
  "files": [
    "dist",
    "config.example.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:validate": "evalkit validate examples/eval-prompts.example.json examples/eval-prompts.fi.json",
    "eval:record": "evalkit run examples/eval-prompts.fi.json --cassette test/cassettes/fi.json --cassette-mode record --baseline test/cassettes/fi.baseline.json --update-baseline --max-tokens 2048",
    "eval:anonymize": "node scripts/anonymize-cassette.mjs test/cassettes/fi.json",
    "eval:replay": "evalkit run examples/eval-prompts.fi.json --cassette test/cassettes/fi.json --baseline test/cassettes/fi.baseline.json --models deepseek-flash --base-url https://litellm.example/v1 --max-tokens 2048",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.2",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "evalkit": "git+https://github.com/tonyweckstrom1987/evalkit.git#8f7a3c08fdf5aebf91ee96f292864c5776f2a667",
    "llm-cassette": "git+https://github.com/tonyweckstrom1987/llm-cassette.git#21f1ffdd1bc730537826aa93317bd8cc6dec051e",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "undici": "^7.2.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "author": "tonyweckstrom1987",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyweckstrom1987/mcp-model-router.git"
  },
  "homepage": "https://github.com/tonyweckstrom1987/mcp-model-router#readme",
  "bugs": {
    "url": "https://github.com/tonyweckstrom1987/mcp-model-router/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "litellm",
    "openrouter",
    "llm",
    "model-routing",
    "eval"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
