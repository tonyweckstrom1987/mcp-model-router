# Kopioi tämä tiedostoksi /opt/mcp-model-router/mcp-model-router.env ja
# täytä oikeat arvot. Tätä tiedostoa EI viedä versionhallintaan (oikeudet 600).

# OpenAI-yhteensopiva rajapinta (LiteLLM-proxy suositeltu)
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=

# Kulutuksen/budjetin luku (yleensä sama proxy kuin yllä)
USAGE_BASE_URL=http://localhost:4000
USAGE_API_KEY=

# HTTP-siirtotapa: kuuntele Tailscale-verkon osoitteessa (ei julkiseen verkkoon)
MCP_HTTP_HOST=100.x.y.z
# Oletus 3100, koska 3000 on usein varattu (esim. Open WebUI) - vaihda tarvittaessa
MCP_HTTP_PORT=3100
# Valinnainen: rajaa sallitut Host-otsikot DNS rebinding -suojausta varten
# MCP_ALLOWED_HOSTS=my-lxc.tailnet-name.ts.net

DB_PATH=/opt/mcp-model-router/data/mcp-model-router.sqlite
